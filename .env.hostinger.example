# Only these two values require user input.
PILOT_DOMAIN=traefik-admin.example.com
ACME_EMAIL=admin@example.com

# install-hostinger.sh generates all values below automatically.
POSTGRES_DB=traefik_pilot
POSTGRES_USER=pilot
POSTGRES_PASSWORD=generated-by-installer
DATABASE_URL=postgres://pilot:generated-by-installer@db:5432/traefik_pilot
JWT_SECRET=generated-by-installer
ENCRYPTION_KEY=generated-by-installer
ADMIN_ORIGIN=https://traefik-admin.example.com
TRAEFIK_LOG_LEVEL=INFO
LOG_LEVEL=info
DEMO_MODE=false
TZ=UTC

