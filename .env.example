POSTGRES_DB=traefik_pilot
POSTGRES_USER=pilot
POSTGRES_PASSWORD=change-me-to-a-long-random-password
DATABASE_URL=postgres://pilot:change-me-to-a-long-random-password@db:5432/traefik_pilot
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-64-hex-characters
ADMIN_ORIGIN=https://traefik-admin.example.com
PILOT_DOMAIN=traefik-admin.example.com
HOSTING_PROVIDER=hostinger
TRAEFIK_NETWORK=traefik-proxy
TRAEFIK_API_URL=http://traefik:8080
TRAEFIK_DYNAMIC_DIR=/data/traefik/dynamic
BACKUP_DIR=/data/backups
LOG_LEVEL=info
DEMO_MODE=false
VITE_API_URL=/api
